# ─────────────────────────────────────────────────────────────
# Sofía — variables de entorno (copiar a .env.local)
# ─────────────────────────────────────────────────────────────

# Base de datos
# Sin DATABASE_URL se usa PGlite (PostgreSQL embebido) persistido en PGLITE_DATA_DIR.
# Con DATABASE_URL (p. ej. Supabase: Settings → Database → Connection string) se usa PostgreSQL real.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sofia
PGLITE_DATA_DIR=.data/pglite
# Aplicar migraciones / sembrar datos DEMO al arrancar.
# Por defecto: automático con PGlite; desactivado con DATABASE_URL (usa `npm run db:migrate` / `db:seed`).
# SOFIA_AUTO_MIGRATE=true
# SOFIA_AUTO_SEED=true

# Cerebro (LLM)
# auto  → usa Claude si hay credenciales de Anthropic; si no, el motor demo determinista.
# demo  → motor demo determinista (sin red, sin costo). Útil para pruebas.
# anthropic → exige credenciales de Anthropic.
SOFIA_LLM_PROVIDER=auto
# ANTHROPIC_API_KEY=
SOFIA_MODEL=claude-opus-5
# low | medium | high | xhigh | max
SOFIA_EFFORT=medium

# Protección básica del panel interno (recomendado si se expone fuera de localhost)
# SOFIA_BASIC_AUTH=mario:una-contraseña-larga

# Almacenamiento privado de documentos (fuera de /public, nunca servido estáticamente)
SOFIA_PRIVATE_STORAGE_DIR=.data/private-docs
