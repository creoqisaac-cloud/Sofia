# ─────────────────────────────────────────────────────────────
# Sofía — variables de entorno (copiar a .env.local)
# ─────────────────────────────────────────────────────────────

# Base de datos
# Sin DATABASE_URL se usa PGlite (PostgreSQL embebido) persistido en PGLITE_DATA_DIR.
# Con DATABASE_URL (p. ej. Supabase: Settings → Database → Connection string) se usa PostgreSQL real.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sofia
PGLITE_DATA_DIR=.data/pglite
# Aplicar migraciones / sembrar datos DEMO al arrancar.
# Por defecto: automático con PGlite; desactivado con DATABASE_URL (usa `npm run db:migrate` / `db:seed`).
# SOFIA_AUTO_MIGRATE=true
# SOFIA_AUTO_SEED=true

# Cerebro (LLM)
# demo  → motor demo determinista (sin red, sin costo). POR DEFECTO (Sprint 2: sin API de IA).
# anthropic → Claude; exige credenciales de una cuenta del proyecto (no personales). Desactivado hasta decidirlo.
# auto  → Claude si hay credenciales de Anthropic; si no, demo.
SOFIA_LLM_PROVIDER=demo
# ANTHROPIC_API_KEY=
SOFIA_MODEL=claude-opus-5
# low | medium | high | xhigh | max
SOFIA_EFFORT=medium

# Protección básica del panel interno (recomendado si se expone fuera de localhost)
# SOFIA_BASIC_AUTH=mario:una-contraseña-larga

# Almacenamiento privado de documentos (fuera de /public, nunca servido estáticamente)
SOFIA_PRIVATE_STORAGE_DIR=.data/private-docs

# WhatsApp Business Cloud API (Meta). Sin estas variables el webhook queda desactivado.
# Credenciales en el gestor de secretos del servidor, NUNCA en git / frontend.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Modo seguro: solo registra conversaciones y deja pendiente a Mario.
# Activar cuando se verifique un modelo de IA REAL y el catálogo NO sea DEMO.
SOFIA_WHATSAPP_AUTOREPLY=false

# BIKY.ai Flows -> Sofía: solo envía citas YA CONFIRMADAS de su Calendario.
# Establece en Flows un nodo HTTP con Authorization: Bearer <token secreto>.
# SOFIA_BIKY_BOOKING_WEBHOOK_TOKEN=

# Avisar automáticamente al WhatsApp de Mario:
# OPCIÓN A: BIKY Flows receptor con envío de plantilla aprobada a Mario.
# SOFIA_MARIO_NOTIFY_FLOW_URL=
# SOFIA_MARIO_NOTIFY_FLOW_TOKEN=
# OPCIÓN B: WhatsApp Cloud API oficial, usando una plantilla aprobada por Meta.
# SOFIA_MARIO_WHATSAPP_TO=52XXXXXXXXXX
# SOFIA_MARIO_TEMPLATE=mario_cita_confirmada
# SOFIA_MARIO_TEMPLATE_LANGUAGE=es_MX
# La plantilla Meta debe tener cinco variables: cliente, fecha, hora, modelo, teléfono.
